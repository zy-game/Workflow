# Copy to /etc/workflow-core/core.env with owner root:root and mode 0600.
# Replace every CHANGE_ME value outside the source tree.
WFC_DATA_DIR=/var/lib/workflow-core
WFC_ALLOW_PLAIN_HTTP=1
WFC_HTTPS_HOST=127.0.0.1
WFC_HTTPS_PORT=18710
WFC_INTERNAL_PORT=18711
WFC_DSH_UPSTREAM=http://127.0.0.1:3081
WFC_MANAGEMENT_AI=0
WFC_FEISHU_ENABLED=1
WFC_FEISHU_APP_ID=CHANGE_ME
WFC_FEISHU_APP_SECRET=CHANGE_ME
WFC_FEISHU_CONNECT_TIMEOUT_MS=30000

# Card buttons require a public HTTPS callback route and verification token.
# Leave disabled for the initial message/card long-connection acceptance.
WFC_FEISHU_CALLBACKS_ENABLED=0
