{
  "name": "workflow-core-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/worker"
  ],
  "scripts": {
    "start": "node packages/core/src/index.js",
    "create-account": "node packages/core/src/index.js create-account",
    "test": "node --test packages/shared/test/*.test.mjs packages/core/test/*.test.mjs packages/worker/test/*.test.mjs",
    "test:shared": "node --test packages/shared/test/*.test.mjs",
    "test:core": "node --test packages/core/test/*.test.mjs",
    "test:worker": "node --test packages/worker/test/*.test.mjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
