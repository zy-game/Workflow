{
  "name": "workflow-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow desktop shell: the server-hosted console plus OS-level idle detection, native notifications and a supervised local executor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.workflow.shell",
    "productName": "Workflow",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "!**/test/**"
    ],
    "extraResources": [
      {
        "from": "../workflow-core/packages",
        "to": "workflow-core/packages",
        "filter": [
          "**/*",
          "!**/test/**"
        ]
      },
      {
        "from": "../workflow-core/node_modules",
        "to": "workflow-core/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../workflow-core/package.json",
        "to": "workflow-core/package.json"
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false
  }
}
