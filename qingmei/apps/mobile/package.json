{
  "name": "@qingmei/mobile",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "cap:sync": "pnpm sync-web && cap sync android",
