{
  "name": "@qingmei/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "青梅桌面宿主（桌宠）：透明置顶、通知气泡、可交互与输入",
  "author": "Qingmei",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.qingmei.desktop",
    "productName": "青梅",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "electron/fullscreen.exe"
    ],
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "qingmei-desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
