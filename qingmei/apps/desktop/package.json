{
  "name": "qingmei-desktop",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "青梅桌面宿主（桌宠）：透明置顶、通知气泡、可交互与输入",
  "author": "Qingmei",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.qingmei.desktop",
    "productName": "青梅",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "electron/fullscreen.exe"
    ],
    "extraResources": [
      {
        "from": "../dsh-companion",
        "to": "dsh-plugins/dsh-companion",
        "filter": [
          "**/*",
          "!test/**",
          "!*.tgz"
        ]
      },
      {
        "from": "../dsh-hook",
        "to": "dsh-plugins/dsh-hook",
        "filter": [
          "**/*",
          "!test/**",
          "!*.tgz"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Qingmei",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "qingmei-desktop-${version}-${arch}.${ext}"
    }
  }
}
