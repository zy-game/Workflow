{
  "name": "qingmei",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm web:build && node apps/server/src/index.ts",
    "dev": "pnpm web:build && node --watch apps/server/src/index.ts",
    "web:build": "pnpm --filter @qingmei/web build",
    "web:dev": "pnpm --filter @qingmei/web dev",
    "qm": "node apps/server/src/cli.ts",
    "serve": "node apps/server/src/cli.ts serve",
    "doctor": "node apps/server/src/cli.ts doctor",
    "smoke": "node scripts/smoke.mjs",
    "worker": "node scripts/harness-worker.mjs",
    "test": "node --test --test-reporter=spec",
    "arch": "node scripts/check-architecture.mjs --strict",
    "config:check": "node scripts/check-config.mjs",
    "backup": "node scripts/backup.mjs",
    "artifacts": "node scripts/check-artifacts.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:smoke": "node scripts/gate.mjs --with-smoke",
    "typecheck": "tsc -p tsconfig.packages.json",
    "memory:eval": "node scripts/eval-memory.mjs",
    "typecheck:all": "tsc -p tsconfig.packages.json",
    "memory:live": "node scripts/eval-memory-live.mjs",
    "memory:browser": "node scripts/browser-test-memories.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  }
}
